generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  password      String?
  accounts      Account[]
  memberships   Membership[]
  sessions      Session[]
  transactions  Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  courierFee           Float             @default(0)
  shopifyWebhookSecret String?
  shopifyWebhookUrl    String?
  plan                 Plan              @default(FREE)
  currentMonthReceipts Int               @default(0)
  currentMonthVoice    Int               @default(0)
  currentMonthText     Int               @default(0)
  currentMonthImage    Int               @default(0)
  usageResetDate       DateTime          @default(now())
  memberships          Membership[]
  // "tags" relation renamed to "drops" — the Tag model is now Drop
  drops                Drop[]
  transactions         Transaction[]
  subscription         Subscription?
  bostaIntegration     BostaIntegration?
  onboardingCompleted  Boolean           @default(false)
  reports              Report[]
  recurringExpenses    RecurringExpense[]

  @@index([slug])
}

model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  provider           String       @default("manual")
  providerCustomerId String?      @unique
  providerSubId      String?      @unique
  status             String
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ─── Drop (formerly Tag) ─────────────────────────────────────────────────────
// Renamed from Tag → Drop. The underlying PostgreSQL table stays as "Tag"
// during migration so no data is lost. A follow-up migration can rename the
// table once stable.
//
// New fields:
//   startDate  — when the drop campaign begins (optional for legacy drops)
//   endDate    — when the drop campaign ends (optional for legacy drops)
//   status     — computed lifecycle: UPCOMING | LIVE | ENDED. Updated by the
//                /api/cron/sync-drop-status hourly cron job.
// ─────────────────────────────────────────────────────────────────────────────
model Drop {
  id             String           @id @default(cuid())
  name           String
  description    String?
  organizationId String
  startDate      DateTime?
  endDate        DateTime?
  status         DropStatus       @default(UPCOMING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Many-to-many: expenses and manually tagged transactions
  transactions   TransactionDrop[]
  // One-to-many: INCOME transactions exclusively attributed to this drop (double-counting prevention)
  primaryTransactions Transaction[] @relation("PrimaryDrop")
  recurringExpenses    RecurringExpense[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("Tag")
}

model Transaction {
  id                  String            @id @default(cuid())
  type                TransactionType
  amount              Decimal           @db.Decimal(10, 2)
  date                DateTime
  category            String
  status              TransactionStatus @default(PENDING)
  paymentMethod       PaymentMethod
  notes               String?
  receiptUrl          String?
  organizationId      String
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shopifyOrderId      String?
  merchant            String?
  bostaTrackingNumber String?           @unique
  bostaState          String?
  shipmentFee         Float?
  bostaLastSyncedAt   DateTime?
  customerCity        String?
  customerId          String?
  fulfillmentStatus   FulfillmentStatus @default(UNFULFILLED)
  lineItems           LineItem[]
  createdBy           User              @relation(fields: [createdById], references: [id])
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Many-to-many join with Drop (for manual multi-drop assignment / expense tagging)
  drops               TransactionDrop[]
  source              TransactionSource @default(MANUAL)

  // ── Revenue double-counting prevention ────────────────────────────────────
  // A transaction can belong to AT MOST ONE drop for revenue purposes.
  // This is the single source of truth for Shopify auto-assignment.
  dropId              String?
  drop                Drop?             @relation("PrimaryDrop", fields: [dropId], references: [id])

  @@unique([shopifyOrderId, organizationId])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@index([organizationId, date, type])
  @@index([organizationId, category])
  @@index([organizationId, dropId])
}

model BostaIntegration {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bostaEmail   String
  token        String @db.Text
  refreshToken String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── TransactionDrop (formerly TransactionTag) ───────────────────────────────
// Renamed from TransactionTag → TransactionDrop.
// Underlying table stays as "TransactionTag" via @@map for zero-data-loss migration.
// This join table supports many-to-many tagging of expenses to drops.
// Revenue transactions use the dropId FK on Transaction for strict exclusivity.
// ─────────────────────────────────────────────────────────────────────────────
model TransactionDrop {
  transactionId String
  dropId        String
  drop          Drop        @relation(fields: [dropId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([transactionId, dropId])
  @@index([dropId])
  @@map("TransactionTag")
}

model LineItem {
  id            String      @id @default(cuid())
  transactionId String
  name          String
  sku           String?
  variantId     String?
  quantity      Int
  price         Decimal     @db.Decimal(10, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

enum Role {
  ADMIN
  ACCOUNTANT
  MEMBER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  RECEIVED
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  INSTAPAY
  COD
}

enum Plan {
  FREE
  PLUS
  PRO
  BUSINESS
}

enum FulfillmentStatus {
  UNFULFILLED
  SHIPPED
  DELIVERED
  RETURNED
}

enum TransactionSource {
  MANUAL
  IMPORT_IMAGE
  IMPORT_CSV
  VOICE
  SHOPIFY
}

// ─── DropStatus ──────────────────────────────────────────────────────────────
// Computed lifecycle state for a Drop campaign.
// UPCOMING — startDate is in the future (or not set)
// LIVE     — today is between startDate and endDate (inclusive)
// ENDED    — endDate is in the past
// ─────────────────────────────────────────────────────────────────────────────
enum DropStatus {
  UPCOMING
  LIVE
  ENDED
}

enum ReportType {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
  INSUFFICIENT_DATA
}

model Report {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type    ReportType
  status  ReportStatus @default(GENERATING)
  version Int          @default(1)

  startDate DateTime
  endDate   DateTime

  // Hero content
  oneParagraphStory String? @db.Text

  // Frequently queried report snapshots
  revenue       Decimal?
  expenses      Decimal?
  profit        Decimal?
  marginPercent Decimal?

  // Structured report sections
  metrics   Json?
  narrative Json?

  // Exact payload sent to the LLM
  inputPayload Json?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type, startDate, endDate])
  @@index([organizationId, type])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringExpense {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  amount         Decimal            @db.Decimal(10, 2)
  category       String
  frequency      RecurringFrequency
  startDate      DateTime
  nextDueDate    DateTime
  dropId         String?
  drop           Drop?              @relation(fields: [dropId], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())

  @@index([organizationId])
  @@index([organizationId, isActive, nextDueDate])
}
